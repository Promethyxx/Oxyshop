import { Palette } from "palette.slint";
import { StatCard, SearchBar, ActionBtn, PmBtn, RibbonChip } from "components.slint";

export struct ExpiryLotRow {
    lot-index: int,
    qty: int,
    date-text: string,
    rel-text: string,
    status: int,
}

export struct ExpiryEntry {
    key: string,
    name: string,
    lots: [ExpiryLotRow],
    total: int,
}

export struct ExpiryGroup {
    name: string,
    icon: string,
    color: color,
    items: [ExpiryEntry],
    alerts: int,
}

export struct ExcludedRow {
    key: string,
    label: string,
    is-cat: bool,
    count: int,
}

export component ExpiryView inherits Rectangle {
    background: Palette.bg;

    in property <int> stat-expired;
    in property <int> stat-soon;
    in property <int> stat-fill;
    in property <[ExpiryGroup]> groups;
    in property <[ExcludedRow]> excluded;
    in property <int> excluded-count;
    in property <bool> lang-en;
    in-out property <string> search-text;
    property <bool> excl-open: false;
    in-out property <int> sel: 0;
    property <int> eff: min(root.sel, max(root.groups.length - 1, 0));
    property <bool> chip-wide: root.groups.length > 0 && (root.width - 40px - 4px * root.groups.length) / root.groups.length > 74px;

    callback search-changed(string);
    callback add-clicked;
    callback add-lot(string);
    callback lot-clicked(string, int);
    callback retire(string, int);
    callback ctx(string);
    callback include(string, bool);

    VerticalLayout {
        padding: 20px; spacing: 0px;

        VerticalLayout {
            spacing: 2px;
            Text { text: lang-en ? "Expiry" : "Expiration"; font-size: Palette.fs-title; font-weight: 700; color: Palette.text; }
            Text { text: lang-en ? "Long press = options · − = used or thrown away" : "Tap long = options · − = consommé ou jeté"; font-size: Palette.fs-xs; color: Palette.text2; }
        }

        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 4px; height: 54px;
            for grp[gi] in root.groups : RibbonChip {
                icon: grp.icon; label: grp.name; badge: grp.alerts;
                selected: gi == root.eff;
                show-label: root.chip-wide;
                clicked => { root.sel = gi; }
            }
        }

        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 8px; height: 64px;
            StatCard { num: root.stat-expired; lbl: lang-en ? "EXPIRED" : "EXPIRÉS";      num-color: Palette.danger; horizontal-stretch: 1; }
            StatCard { num: root.stat-soon;    lbl: lang-en ? "SOON (7D)" : "BIENTÔT 7J"; num-color: Palette.amber;  horizontal-stretch: 1; }
            StatCard { num: root.stat-fill;    lbl: lang-en ? "TO FILL" : "À RENSEIGNER"; num-color: Palette.gold;   horizontal-stretch: 1; }
        }

        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 8px; height: 38px;
            SearchBar {
                horizontal-stretch: 1;
                text <=> root.search-text;
                placeholder: lang-en ? "Search item..." : "Chercher un article...";
                edited(t) => { root.search-changed(t); }
            }
            ActionBtn {
                label: lang-en ? "+ Add" : "+ Ajouter"; primary: true; small: true;
                width: 90px;
                clicked => { root.add-clicked(); }
            }
        }

        Rectangle { height: 12px; }

        Flickable {
            vertical-stretch: 1;
            max-height: 10000px;
            content-height: list-col.preferred-height;

            list-col := VerticalLayout {
                spacing: 0px;

                for grp[gi] in root.groups : VerticalLayout {
                    spacing: 0px;

                    if gi == root.eff : VerticalLayout {
                        spacing: 5px; padding-top: 4px;

                        for entry in grp.items : Rectangle {
                            height: entry-col.preferred-height;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.card-border;
                            background: Palette.card;

                            entry-col := VerticalLayout {
                                Rectangle {
                                    height: 44px;

                                    lp-timer := Timer {
                                        interval: 500ms; running: false;
                                        triggered => { self.running = false; root.ctx(entry.key); }
                                    }
                                    TouchArea {
                                        pointer-event(pe) => {
                                            if pe.kind == PointerEventKind.down { lp-timer.running = true; }
                                            if pe.kind == PointerEventKind.up || pe.kind == PointerEventKind.cancel { lp-timer.running = false; }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            text: entry.name;
                                            font-size: Palette.fs; font-weight: 500;
                                            color: entry.lots.length == 0 ? Palette.text3 : Palette.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if entry.lots.length > 0 : Text {
                                            text: "× " + entry.total;
                                            font-size: Palette.fs-md; color: Palette.text2;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 30px;
                                            PmBtn {
                                                y: (parent.height - self.height) / 2;
                                                label: "+";
                                                clicked => { root.add-lot(entry.key); }
                                            }
                                        }
                                    }
                                }

                                for lot in entry.lots : Rectangle {
                                    height: 40px;

                                    Rectangle {
                                        y: 0px; height: 1px;
                                        background: Palette.card-border;
                                    }

                                    lot-ta := TouchArea { clicked => { root.lot-clicked(entry.key, lot.lot-index); } }

                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 8px;
                                        spacing: 8px;

                                        Rectangle {
                                            width: 8px;
                                            Rectangle {
                                                width: 8px; height: 8px; border-radius: 4px;
                                                y: (parent.height - self.height) / 2;
                                                background: lot.status == 1 ? Palette.danger
                                                          : lot.status == 2 ? Palette.amber
                                                          : lot.status == 3 ? Palette.green
                                                          :                   Palette.text3;
                                            }
                                        }
                                        Text {
                                            text: "× " + lot.qty;
                                            font-size: Palette.fs-md; font-weight: 600; color: Palette.text;
                                            vertical-alignment: center;
                                            width: 34px;
                                        }
                                        Text {
                                            text: lot.status == 0 ? "—" : lot.date-text;
                                            font-size: Palette.fs; color: Palette.text;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: lot.rel-text;
                                            font-size: Palette.fs-md; font-weight: 600;
                                            color: lot.status == 1 ? Palette.danger
                                                 : lot.status == 2 ? Palette.amber
                                                 : lot.status == 3 ? Palette.text2
                                                 :                   Palette.gold;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                        }
                                        Rectangle {
                                            width: 30px;
                                            PmBtn {
                                                y: (parent.height - self.height) / 2;
                                                label: "−";
                                                clicked => { root.retire(entry.key, lot.lot-index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.excluded-count > 0 : VerticalLayout {
                    spacing: 0px; padding-top: 10px;

                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: excl-ta.pressed ? Palette.card : transparent;
                        excl-ta := TouchArea { clicked => { root.excl-open = !root.excl-open; } }
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px;
                            spacing: 8px; alignment: center;
                            Text { text: "🚫"; font-size: 15px; }
                            Text { text: lang-en ? "Excluded" : "Exclus"; font-size: Palette.fs; font-weight: 600; color: Palette.text2; horizontal-stretch: 1; }
                            Rectangle {
                                width: excl-cnt.preferred-width + 14px; height: 18px; border-radius: 9px;
                                background: Palette.card;
                                excl-cnt := Text { text: root.excluded-count; font-size: Palette.fs-xs; font-weight: 500; color: Palette.text2; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: root.excl-open ? "▾" : "▸"; font-size: Palette.fs-xs; color: Palette.text3; }
                        }
                    }

                    if root.excl-open : VerticalLayout {
                        spacing: 5px; padding-top: 4px;

                        for row in root.excluded : Rectangle {
                            height: 46px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.card-border;
                            background: Palette.card;

                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: row.is-cat ? row.label + "  (" + row.count + ")" : row.label;
                                    font-size: Palette.fs; color: Palette.text2;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 96px;
                                    ActionBtn {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        small: true;
                                        label: lang-en ? "Include" : "Réintégrer";
                                        clicked => { root.include(row.key, row.is-cat); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
